# Environment Configuration for FDR-Sentinel
# Problem Statement: SIH26265 - AICTE FDR Portal Prototype

ENVIRONMENT=development
SECRET_KEY=dev_insecure_jwt_secret_key_sih2026_fdr_sentinel_0987654321
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AES-256 Master Key (32 bytes hex encoded) for document encryption at rest
AES_MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+psycopg2://sentinel_user:sentinel_pass@postgres:5432/fdr_sentinel
TEST_DATABASE_URL=sqlite:///./test_sentinel.db

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# MinIO / S3 Storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=sentinel_minio_admin
MINIO_SECRET_KEY=sentinel_minio_secret_key_2026
MINIO_BUCKET_NAME=fdr-documents
MINIO_SECURE=false

# SMTP / MailHog
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=sentinel-noreply@aicte-india.org
EMAILS_FROM_NAME="FDR-Sentinel Alerts"

# ClamAV (Optional scan container)
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Synthetic Seed & Honesty Banner
SYNTHETIC_DATASET_SEED=42
DEMO_CLOCK_OFFSET_DAYS=0
